      "name": "Respond to Webhook"
    },
    {
      "parameters": {
        "jsCode": "// Get Google Sheet rows (input 0)\nconst sheetRows = $input.all(0).map(item => item.json);\n\n// Get webhook email from input 1\nconst webhookData = $('Webhook').first();\nconst webhookEmail = webhookData?.json?.body?.email;\n\n// If no sheet data, allow adding new email\nif (!sheetRows.length) {\n  return [\n    {\n      json: {\n        count: 0,\n        action: 'add_new'\n      }\n    }\n  ];\n}\n\n// Count matches in sheet\nconst matches = sheetRows.filter(row => row[\"Your Email\"] === webhookEmail);\n\n// If no match, allow adding new email\nif (matches.length === 0) {\n  return [\n    {\n      json: {\n        count: 0,\n        action: 'add_new'\n      }\n    }\n  ];\n}\n\n// If match found, return count\nreturn [\n  {\n    json: {\n      count: matches.length,\n      action: 'exists'\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
